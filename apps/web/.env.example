# Primary Prisma connection string used by the web app.
DATABASE_URL="postgresql://postgres@your-project.neon.tech/neondb"

# Direct database connection for migrations or admin operations.
DIRECT_URL="postgresql://postgres@your-project.neon.tech/neondb"

# Public base URL for the Next.js app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Search Console ownership and consent-gated marketing measurement.
GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_LABEL=""
NEXT_PUBLIC_META_PIXEL_ID=""

# One-time bootstrap code used to create the first admin account at /admin/setup.
ADMIN_SETUP_CODE="replace-me"

# Secret used to sign admin session cookies.
ADMIN_SESSION_SECRET="replace-me"

# Secret used to sign moderator portal session cookies.
MODERATOR_SESSION_SECRET="replace-me"

# Secret used to sign promoter portal session cookies.
PROMOTER_SESSION_SECRET="replace-me"

# Secret used to sign member account session cookies.
USER_SESSION_SECRET="replace-me"

# Resend credentials used for account verification and password reset emails.
# The sender must be on a domain verified in Resend.
RESEND_API_KEY="replace-me"
RESEND_FROM_EMAIL="Card Show Nation <noreply@cardshownation.com>"
# Keep true in production so new accounts must prove control of their email address.
SIGNUP_EMAIL_VERIFICATION_REQUIRED="true"

# Shared secret used to authenticate scheduled job requests.
CRON_SECRET="replace-me"

# Discord bot credentials for the managed #upcoming-shows channel. The state
# defaults to KS so regional/nationwide Discord publishing stays off.
DISCORD_BOT_TOKEN="replace-me"
DISCORD_UPCOMING_SHOWS_CHANNEL_ID="replace-me"
DISCORD_UPCOMING_SHOWS_STATE="KS"

# Vercel Blob token required in production for durable flyer uploads.
BLOB_READ_WRITE_TOKEN="replace-me"

# Secret used to sign the short-lived floor-planner cloud session cookie.
FLOORPLANNER_SESSION_SECRET=""

# Stripe server key, webhook signing secret, and the active $19.99/month USD Price ID.
# New checkout sessions remain disabled unless PURCHASING_ENABLED is exactly true.
PURCHASING_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_FLOORPLANNER_MONTHLY_PRICE_ID=""

# Browser E2E target. Use an isolated preview deployment for database-backed tests.
E2E_BASE_URL="http://127.0.0.1:3100"
E2E_DATABASE_URL="postgresql://postgres@your-e2e-project.neon.tech/neondb"

# Pre-seeded, verified accounts used only by the opt-in beta auth tests.
E2E_FAN_EMAIL="fan-e2e@example.com"
E2E_FAN_PASSWORD="replace-me"
E2E_PROMOTER_EMAIL="promoter-e2e@example.com"
E2E_PROMOTER_PASSWORD="replace-me"
E2E_FOREIGN_SHOW_ID="replace-with-an-unowned-show-id"

# Google OAuth web client. Add the callback URL below as an authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID="replace-me.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="replace-me"
GOOGLE_OAUTH_REDIRECT_URI="https://cardshownation.com/api/auth/google/callback"
